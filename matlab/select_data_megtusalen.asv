%% Comparison of Megtusalen data
%
% Sample size between brackets indicates the number of participants that
% were assigned an ID. Participants can have partial data (e.g. only MEG
% without neuropyschological assessment or without MRI data) or no data at
% all.
%
% Cristina Gil Avila, 11/03/2025, C3N


%% Load most recent megtusalen dataset (excel sheet)
clear all, close all

% supermegtusalen_global_v2024_nans.xls (N=760)

% Information about MEG Data
megtusalen_meg = readtable('../data/supermegtusalen_global_v2024_nans.xlsx','Sheet','megdata',ReadVariableNames=true, VariableNamesRange='A1:H1', DataRange="A2:H761");

% Information about demographic data
megtusalen_sample = readtable('../data/supermegtusalen_global_v2024_nans.xlsx','Sheet','sample');

% Clinical information based on MRI (existance of tumors, hemorrages, etc.)
megtusalen_mri = readtable('../data/supermegtusalen_global_v2024_nans.xlsx','Sheet','mri reports');

% Participants' diagnosis based on neurocognitive tests (only healthy
% participants)
cog_healthy = readtable('../data/megtusalen_cog_healthy_Nov2024.xlsx','Sheet','sample'); % N = 456

% Make sure that participants' labels are the same in all the excel sheets
mask1 = cellfun(@isequal, megtusalen_meg.id_meg, megtusalen_sample.id_meg);
mask2 = cellfun(@isequal, megtusalen_meg.id_meg, megtusalen_mri.id_meg);
if ~all(mask1 & mask2)
    warning('The order of participants labels does not match between excel sheets.');
end
clear mask1 mask2

% Make sure that all recordings belong to baseline (no longitudinal data) 
id_meg = megtusalen_meg.id_meg;
% Check if all supermegtusalen recordings are baseline recordings
id_1 = cellfun(@(x) numel(x) >= 2 && x(2) == '1', id_meg);
if ~all(id_1)
    warning('Check for longitudinal recordings.\n')
end

%% Inclusion and exclusion criteria (Cristina)

% 1. Participant must have a group label
% 2. Participant must have basic demographic data (age, gender)
% 3. Participant must have an ok MRI report (no tumors, no ictus)
% 4. For healthy controls, participant must not have a negative
% neuropsychological assessment.
% 5. Participant must have a raw MEG recording (sensor data)
% 6. Participant must have power spectrum in source space

% 1. Participants with a defined group label (N = 730) Excluded N = 30
diag = megtusalen_sample.diag;
mask_diag = ~isnan(diag);

% 2. Participants with demographic data
mask_age = ~isnan(megtusalen_sample.age); % N = 717
mask_gender = ~isnan(megtusalen_sample.sex); % N = 723

% Participants that DO NOT have a diagnosis or classification of 'tumor' based on
% their MRI. (N = 745) Excluded N = 15
mri_diag = megtusalen_mri.diagnostic;
mri_class = megtusalen_mri.classification;
diag_tumor = contains(mri_diag,'tumor');
class_tumor = contains(mri_class,'tumor');
mask_notumor = ~or(diag_tumor,class_tumor);

% Participants that DO NOT have a large lession (hemorragic, ischemic, etc.) in
% their MRI. (N = 742) Excluded N = 18
mri_lession = megtusalen_mri.x1LargeLesion;
mask_nolession = strcmp(mri_lession,'nan');

% 3. Participants without tumors or ictus (N = 727) Excluded N = 33
mask_mriok = mask_notumor & mask_nolession;

% 4. Participants without a negative neuropsychological assessment (N =
% 739)

% diagcog labels
% 0 - CN that fails more than 2 neurocognitive tests
% 1 - CN that fails 2 or 1 neurocognitive tests
% 2 - CN superhealthy (no fail)

% Participants with diagnosis based on neurocognitive tests
diagcog = nan(length(diag),1);
has_diagcog = ismember(id_meg,cog_healthy.id_meg);
diagcog(has_diagcog) =  cog_healthy.diagcog;

% Discard healthy participants that are not really healthy based on their
% neurocognitive assesment (N = 21)
mask_diagcog = ~(diagcog == 0);

% 5. Participants with an MEG recording (sensor data) according the excel file (N = 677) 
mask_sens =  ~isnan(megtusalen_meg.exist_sens);

% 6. Participants with a power spectrum in sensor space (N = 617)
mask_pow = ~isnan(megtusalen_meg.exist_pow_sources);

mask1 = mask_diag; % N = 730
mask2 = mask_diag & mask_age & mask_gender; % N = 717
mask3 = mask_diag & mask_age & mask_gender & mask_mriok; % N = 684
mask4 = mask_diag & mask_age & mask_gender & mask_mriok & mask_diagcog; % N = 665
mask5 = mask_diag & mask_age & mask_gender & mask_mriok & mask_diagcog & mask_sens; % N = 611
mask6 = mask_diag & mask_age & mask_gender & mask_mriok & mask_diagcog & mask_sens & mask_pow; % N = 555

%% Inclusion and exclusion criteria (Adrian)

% 1. Participant must be equal or older than 50
% 2. Participant must have an ok MRI report (no tumors, no ictus)
% 3. Participant must have power spectrum in source space
% 4. Participant must have functional connectivity in source space

% Participants that are older than 50. (N = 704)
mask_age = megtusalen_sample.age >= 50;

% Participants that have functional connectivity calculated at sources (N=618)
mask_fc = ~isnan(megtusalen_meg.exist_fc_sources);

% Included participants (N=559)
mask_adri = mask_age & mask_pow & mask_fc & mask_mriok;

% Participants included by Cristina that are not included by Adri (N = 11,
% young)
id_cris = id_meg(mask6);
pc = id_cris(~ismember(id_meg(mask6),id_meg(mask_adri)));
megtusalen_sample(ismember(id_meg,pc),:)

% Participants inclluded by Adri that are not included by Cristina (not
% truly healthy according the neuro)
id_adri = id_meg(mask_adri);
pa = id_adri(~ismember(id_meg(mask_adri),id_meg(mask6)));
megtusalen_sample(ismember(id_meg,pa),:)


%% List all the available raw files (raw fif and tsss fif) in the dropbox folder
% Note: all raw .fif files before maxfilter are in a separate server (not
% dropbox) managed by Bruña. tsss data could be reconstructed in those
% participants. In the dropbox folder below there is a mix of raw .fif
% files and tsss .fif files

dropbox_path = 'C:\Users\Cristina\C3N Dropbox\Proyectos\Megtusalen\data\tsss';
fif = dir(fullfile(dropbox_path,'*.fif'));
fif_name = {fif.name};
id_fif = cellfun(@(x) x{1}, cellfun(@(y) strsplit(y, '_'), fif_name, 'UniformOutput', false), 'UniformOutput', false); % (N=715)

% Some participants have more than one fif file. It is unknown which .fif file was used
% to obtain derivative data from these participants.

% All unique participants ids (N=674)
[id_fif_unique, ~, idx] = unique(id_fif);

% Duplicate participants (N=41)
counts = accumarray(idx, 1);
id_fif_duplicate = id_fif_unique(counts > 1);
duplicate_pos = ismember(id_fif, id_fif_duplicate);
duplicates = fif(duplicate_pos,:);

% Non-duplicate participants (N=633)
id_fif_nonduplicate = id_fif_unique(~ismember(id_fif_unique,id_fif_duplicate));


% Identify participants that have raw fif, tsss, or both
tsss = id_fif(contains(fif_name,'tsss')); % (N=700)
no_tsss = id_fif(~contains(fif_name,'tsss')); % (N=15)

unique_tsss = unique(tsss); % (N=661)
unique_notsss = unique(no_tsss); % (N=15)

% Identify participants that have both tsss and raw fif files (N=2)
both_tsss_fif = unique_notsss(ismember(unique_notsss,unique_tsss));

% Participants that only have raw fif file and no tsss (N=13)
onlyfif = unique_notsss(~ismember(unique_notsss,both_tsss_fif));

%% Compare fif participants with the excel sheet participants
% Identify participants that DO have a MEG recording according to the excel
% file (N=677)
mask_sens = ~isnan(megtusalen_meg.exist_sens);
meg_sens = megtusalen_meg(mask_sens,:);
sample_sens = megtusalen_sample(mask_sens,:);
id_sens = id_meg(mask_sens);


% Identify participants that have a meg recording according to the excel file but do not have a .fif
% file (neither raw fif nor tsss). (N=40)
excel_no_fif = id_sens(~ismember(id_sens,id_fif_unique));

% Identify participants that have .fif file but do not appear in the excel file as having MEG data. (N=37)
fif_no_excel = id_fif_unique(~ismember(id_fif_unique,id_sens));


%% Participants based on diagnosis

% diag labels
%  1 = Control (de MCI)
%  2 = Control con QSM
%  3 = DCLa (solo amnesia)
%  4 = DCLm (multidominio con amnesia)
%  5 = DCLu (multidominio sin amnesia)
%  6 = AD
%  7 = control con antecedentes de AD
%  8 = control sin QSM
%  9 = control sin antecedentes de AD
cn  = [1, 2, 7, 8, 9];
mci = [3, 4, 5];
ad  = 6;

mask_cn  = sum(diag == cn ,2); % N = 520
mask_mci = sum(diag == mci ,2); % N = 185
mask_ad  = sum(diag == ad ,2); % N = 25

% % Check with Simplified diagnosis variable
% diag_mac = megtusalen_sample.diag_mac;
% isequal(diag_mac == 1, mask_cn)
% isequal(diag_mac == 2, mask_dcl)
% isequal(diag_mac == 3, mask_ad)

mask_cn  = (diag == cn ,2); % N = 520
mask_mci = sum(diag == mci ,2); % N = 185
mask_ad  = sum(diag == ad ,2); % N = 25

%% Cristina's inclusion and exclusion criteria checks

% Participants with sensor data that do not have power at sources. N = 60
sum(mask_sens & (~mask_pow))

% Participants with power at sources that do not have sensor data N = 0
sum(mask_pow & (~mask_sens))

% Participants that have power data that do not have fc. N = 0 -> fc mask is irrelevant
sum(mask_pow & (~mask_fc))

% Participants that have fc data but do not have power data. N = 1
sum(mask_fc & (~mask_pow))


%% CHECK other excel files

% Megtusalen_tesis_adri.xls (N=760)
% Same participants as in supermegtusalen but some extra columns were added 
% to the excel sheet.
megtusalen_adri = readtable('../data/megtusalen_tesis_adri_v2025.xlsx');
id_adri = megtusalen_adri.id_meg;

% Megtusalen_vJescab.xls (N=729)
% The excel file includes also longitudinal recordins. Sample of N=729 was
% obtained after removing longitudinal recordings.
megtusalen_meg = readtable('../data/megtusalen_vJescab.xlsx');

% Discard longitudinal recordings (there is a 2 in the second position of ID_OBSERVACION)
id_jes = megtusalen_meg.ID_OBSERVACION;
id_1 = cellfun(@(x) numel(x) >= 2 && x(2) == '1', id_jes);
megtusalen_meg = megtusalen_meg(id_1,:);

% Comparison of MEG ids included in Megtusalen_tesis_adri and supermegtusalen_global
% Both datasets contain the same individuals
sum(ismember(id_adri,id_meg))
sum(ismember(id_meg,id_adri))

% Comparison of MEG ids included in Megtusalen_vJescab and Megtusalen_tesis_adri
% All the members in Jesus' excel are present in Adri's excel
nin_jes = sum(ismember(id_jes, id_adri));

% Only 729 out of 760 members in Adris' excel are present in Jesus' excel
nin_adri = sum(ismember(id_adri, id_jes));

% 31 members in Adris' excel are not present in Jesus' excel. No data
% present on most of these individuals.
nout_adri = sum(~ismember(id_adri, id_jes));
out_adri = id_adri(~ismember(id_adri, id_jes));
megtusalen_adri(~ismember(id_adri, id_jes),:)

% Conclusion: take supermegtusalen as a baseline excel sheet
